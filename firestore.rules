rules_version = '2';

// VinylVault Cross-Device Sync — Firestore Security Rules
//
// Access model: each collection lives under /vaults/{vaultCode}/shelfItems/{itemId}.
// The vault code IS the access credential (like a shared secret room code) — there is
// no Firebase Auth / login in this app. Anyone who knows a vault's code can read and
// write that vault's records, nothing else.
//
// This is only safe because vault codes are generated client-side as 20-character
// cryptographically random strings (see src/utils/vaultSync.ts, generateVaultCode),
// making them infeasible to guess or brute-force. The `size() >= 16` check below
// blocks trivially short/guessable paths from ever being valid, as defense in depth.
//
// To apply: Firebase Console → Firestore Database → Rules → paste this file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{vaultCode}/shelfItems/{itemId} {
      allow read, write: if vaultCode is string && vaultCode.size() >= 16;
    }
  }
}

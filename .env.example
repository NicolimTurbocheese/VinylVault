# --- Frontend (root project) ---

# Where the Firebase Cloud Functions backend is deployed. Required for Scan/Search,
# valuation recalculation, and cover art refresh to work. Example:
#   https://us-central1-your-project-id.cloudfunctions.net
VITE_API_BASE_URL=

# Cross-device sync (optional). Leave unset to run with local-only (per-browser) storage.
# Get these values from Firebase Console → Project Settings → General → Your apps → Web app config.
# These are NOT secret (they identify the project, not grant access) — safe to expose client-side.
# Access is actually controlled by firestore.rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend (functions/ project) ---
#
# GEMINI_API_KEY is NOT set here. It's a real secret (used server-side by
# functions/src/identifyRecord.ts and recalculateValuation.ts) and is managed
# through Firebase Secret Manager instead of a .env file:
#
#   cd functions && firebase functions:secrets:set GEMINI_API_KEY
#
# Never prefix a real secret with VITE_ — anything with that prefix gets bundled
# into the public client-side JS.
